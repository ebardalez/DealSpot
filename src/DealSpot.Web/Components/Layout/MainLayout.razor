@inherits LayoutComponentBase
@inject DealSpot.Application.Abstractions.Tenancy.ITenantContext TenantContext

<div class="dealspot-layout"
     style="--color-primary: @TenantContext.Current.Branding.PrimaryColor;
            --color-secondary: @TenantContext.Current.Branding.SecondaryColor">

    <header class="site-header">
        <nav class="nav-container">
            <a href="/" class="site-logo">
                <img src="@TenantContext.Current.Branding.LogoUrl" alt="@TenantContext.Current.Name" />
            </a>

            <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
            <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">&#9776;</label>

            <div class="nav-links">
                <a href="/">Deals</a>
                <a href="/categories">Categories</a>
                <a href="/submit">Submit</a>
            </div>

            <div class="nav-auth">
                <AuthorizeView>
                    <Authorized>
                        <span class="nav-user-name">@context.User.Identity?.Name</span>
                        <a href="/watchlist">Watchlist</a>
                        <a href="/settings/notifications">Settings</a>
                        <AuthorizeView Policy="Admin">
                            <Authorized Context="adminContext">
                                <a href="/admin/deals">Admin</a>
                            </Authorized>
                        </AuthorizeView>
                        <form action="/auth/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit">Sign Out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/auth/login/Google" class="btn-signin">Sign in with Google</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <p>
            &copy; @DateTime.UtcNow.Year @TenantContext.Current.Name &mdash;
            Affiliate disclosure: we may earn a commission on purchases made through our links.
        </p>
    </footer>
</div>
