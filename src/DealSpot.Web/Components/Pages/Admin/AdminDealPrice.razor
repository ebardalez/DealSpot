@page "/admin/deals/{DealId:guid}/price"
@using DealSpot.Application.Deals.PriceHistory
@using DealSpot.Domain.Deals
@using MediatR
@inject ISender Mediator
@inject IDealRepository DealRepository
@inject NavigationManager Nav
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer

<PageTitle>Update Price — Admin</PageTitle>

<section class="admin-page">
    <h1>Update Price</h1>
    <p><a href="/admin/deals">&larr; Back to deals</a></p>

    @if (_deal is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h2>@_deal.Title</h2>
        <p>Current: @_deal.Price.CurrentPrice.ToString("C") @if (_deal.Price.OriginalPrice.HasValue) { <text>(was @_deal.Price.OriginalPrice.Value.ToString("C"))</text> }</p>

        <div class="form-group">
            <label>New Current Price</label>
            <input type="number" step="0.01" min="0.01" @bind="_newPrice" class="form-control" />
        </div>
        <div class="form-group">
            <label>New Original Price (optional)</label>
            <input type="number" step="0.01" min="0" @bind="_newOriginalPrice" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-danger">@_error</p>
        }
        @if (_success)
        {
            <p class="text-success">Price updated.</p>
        }

        <button class="btn btn--primary" @onclick="UpdateAsync" disabled="@_saving">@(_saving ? "Saving…" : "Update Price")</button>

        @if (_history is not null && _history.Count > 0)
        {
            <h3 style="margin-top:2rem">Price History</h3>
            <table class="admin-table">
                <thead><tr><th>Date</th><th>Price</th><th>Original</th><th>Source</th></tr></thead>
                <tbody>
                    @foreach (var s in _history)
                    {
                        <tr>
                            <td>@s.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@s.Price.ToString("C")</td>
                            <td>@(s.OriginalPrice?.ToString("C") ?? "—")</td>
                            <td>@s.Source</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</section>

@code {
    [Parameter] public Guid DealId { get; set; }

    private Deal? _deal;
    private decimal _newPrice;
    private decimal? _newOriginalPrice;
    private string? _error;
    private bool _success;
    private bool _saving;
    private IReadOnlyList<PriceSnapshotDto>? _history;

    protected override async Task OnInitializedAsync()
    {
        _deal = await DealRepository.GetByIdAsync(DealId);
        if (_deal is null) { Nav.NavigateTo("/admin/deals", replace: true); return; }

        _newPrice = _deal.Price.CurrentPrice;
        _newOriginalPrice = _deal.Price.OriginalPrice;
        await LoadHistory();
    }

    private async Task UpdateAsync()
    {
        _error = null; _success = false; _saving = true;
        var result = await Mediator.Send(new UpdateDealPriceCommand(DealId, _newPrice, _newOriginalPrice));
        _saving = false;

        if (result.IsFailure) { _error = result.Error.Description; return; }

        _success = true;
        _deal = await DealRepository.GetByIdAsync(DealId);
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        var result = await Mediator.Send(new GetPriceHistoryQuery(DealId));
        if (result.IsSuccess) _history = result.Value;
    }
}
