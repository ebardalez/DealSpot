<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.2.4" />

  <!-- Workaround: Aspire SDK checks $(OS)==Windows_NT to append .exe to DcpCliPath,
       but $(OS) is empty in .NET 10 SDK. Pre-set the full path so the SDK condition
       '$(DcpCliPath)' == '' is false and it doesn't overwrite with the .exe-less value. -->
  <Target Name="FixDcpCliPath" BeforeTargets="SetOrchestrationDiscoveryAttributes">
    <PropertyGroup>
      <DcpCliPath Condition="'$(DcpCliPath)' != '' and !$(DcpCliPath.EndsWith('.exe'))">$(DcpCliPath).exe</DcpCliPath>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>dealspot-apphost</UserSecretsId>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DealSpot.Web\DealSpot.Web.csproj" />
  </ItemGroup>

</Project>
